/// <summary>
/// Singleton setup of the Ledger Application Assistant.
/// Intentionally minimal: payment tolerance is NOT duplicated here, it stays
/// owned by the standard Business Central General Ledger Setup.
/// </summary>
table 87500 "LAA_LedgerApplSetup"
{
    Caption = 'Ledger Application Setup', Comment = 'ESP="Configuracion de liquidacion de movimientos"';
    DataClassification = CustomerContent;
    Extensible = false;
    DrillDownPageId = "LAA_LedgerApplSetup";
    LookupPageId = "LAA_LedgerApplSetup";

    fields
    {
        field(1; "Primary Key"; Code[10])
        {
            Caption = 'Primary Key', Comment = 'ESP="Clave primaria"';
            DataClassification = SystemMetadata;
        }
        field(10; "Max. Match Date Difference"; Integer)
        {
            Caption = 'Max. Match Date Difference (Days)', Comment = 'ESP="Dif. max. de fechas para conciliar (dias)"';
            ToolTip = 'Specifies the maximum difference, in days, allowed between two entries matched only by amount. Explicit references ignore this limit. Leave it blank to disable the date restriction.', Comment = 'ESP="Especifica la diferencia maxima, en dias, permitida entre dos movimientos conciliados solo por importe. Las referencias explicitas ignoran este limite. Dejelo en blanco para desactivar la restriccion de fechas."';
            DataClassification = CustomerContent;
            MinValue = 0;
            BlankZero = true;
        }
        field(11; "Max. Combination Lines"; Integer)
        {
            Caption = 'Max. Combination Lines', Comment = 'ESP="Max. lineas por combinacion"';
            ToolTip = 'Specifies how many entries at most may take part in an exact 1:N combination search. Keep this value small: it bounds the search and keeps the proposed groups understandable.', Comment = 'ESP="Especifica cuantos movimientos como maximo pueden participar en una busqueda de combinacion exacta 1:N. Mantenga un valor bajo: limita la busqueda y hace comprensibles los grupos propuestos."';
            DataClassification = CustomerContent;
            MinValue = 2;
            MaxValue = 20;
            InitValue = 10;
        }
        field(20; "Enable Residual FIFO"; Boolean)
        {
            Caption = 'Enable Residual FIFO', Comment = 'ESP="Activar FIFO residual"';
            ToolTip = 'Specifies whether the final low-confidence FIFO allocation runs after the deterministic matching levels. FIFO allocates the remaining compatible balances oldest first.', Comment = 'ESP="Especifica si la asignacion FIFO final de baja confianza se ejecuta despues de los niveles de conciliacion deterministas. FIFO asigna los saldos compatibles restantes empezando por el mas antiguo."';
            DataClassification = CustomerContent;
            InitValue = true;
        }
        field(21; "FIFO Default Confidence"; Enum "LAA_Confidence")
        {
            Caption = 'FIFO Default Confidence', Comment = 'ESP="Confianza por defecto de FIFO"';
            ToolTip = 'Specifies the informational confidence assigned to groups generated by the residual FIFO allocation.', Comment = 'ESP="Especifica la confianza informativa asignada a los grupos generados por la asignacion FIFO residual."';
            DataClassification = CustomerContent;
            InitValue = Low;
        }
        field(30; "Enable AI Matching"; Boolean)
        {
            Caption = 'Enable AI Matching', Comment = 'ESP="Activar conciliacion con IA"';
            ToolTip = 'Specifies whether the ambiguous cases left by the deterministic matching levels are sent to the AI agent before the residual FIFO allocation runs. The AI only chooses between candidates that the deterministic engine already preselected, and every proposal it makes is validated again before a group is created.', Comment = 'ESP="Especifica si los casos ambiguos que dejan los niveles de conciliacion deterministas se envian al agente de IA antes de ejecutar la asignacion FIFO residual. La IA solo elige entre candidatos que el motor determinista ya ha preseleccionado, y cada propuesta se valida de nuevo antes de crear un grupo."';
            DataClassification = CustomerContent;
            InitValue = false;
        }
        field(31; "AI Multiple Exact Confidence"; Enum "LAA_Confidence")
        {
            Caption = 'AI Multiple Exact Confidence', Comment = 'ESP="Confianza IA varias coincidencias exactas"';
            ToolTip = 'Specifies the informational confidence assigned to groups the AI resolves from several mathematically valid exact candidates.', Comment = 'ESP="Especifica la confianza informativa asignada a los grupos que la IA resuelve entre varios candidatos exactos matematicamente validos."';
            DataClassification = CustomerContent;
            InitValue = High;
        }
        field(32; "AI Partial Confidence"; Enum "LAA_Confidence")
        {
            Caption = 'AI Partial Confidence', Comment = 'ESP="Confianza IA coincidencia parcial"';
            ToolTip = 'Specifies the informational confidence assigned to groups the AI resolves from a partial, incomplete relationship.', Comment = 'ESP="Especifica la confianza informativa asignada a los grupos que la IA resuelve a partir de una relacion parcial e incompleta."';
            DataClassification = CustomerContent;
            InitValue = Medium;
        }
        field(33; "AI Textual Ref. Confidence"; Enum "LAA_Confidence")
        {
            Caption = 'AI Textual Reference Confidence', Comment = 'ESP="Confianza IA referencia textual"';
            ToolTip = 'Specifies the informational confidence assigned to groups the AI resolves from a textual reference that the deterministic engine found but could not confirm on its own.', Comment = 'ESP="Especifica la confianza informativa asignada a los grupos que la IA resuelve a partir de una referencia textual que el motor determinista encontro pero no pudo confirmar por si solo."';
            DataClassification = CustomerContent;
            InitValue = High;
        }
    }

    keys
    {
        key(PK; "Primary Key")
        {
            Clustered = true;
        }
    }

    /// <summary>
    /// Returns the singleton setup record, creating it with its default values
    /// the first time it is requested.
    /// </summary>
    internal procedure fGetSetup()
    begin
        if Rec.Get() then
            exit;

        Rec.Init();
        Rec.Insert(true);
    end;
}
